@model List<ViewDutyDto>
@{
    ViewData["Title"] = "DutyIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Referans Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Hizmet Adı</th>
                                    <th>Hizmet Açıklama</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                    <th>Detay</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.DutyID</td>
                                        <td>@item.Title</td>
                                        <td>@item.Desc</td>
                                        <td>
                                            <a asp-controller="Duty"
                                               asp-action="DeleteDuty"
                                               asp-route-id="@item.DutyID"
                                               class="btn btn-success form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Duty"
                                               asp-action="EditDuty"
                                               asp-route-id="@item.DutyID"
                                               class="btn btn-success form-group">Güncelle</a>
                                        </td>

                                        <td>
                                            <a href="#" class="btn btn-info btn-sm">
                                                Detay
                                            </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="Duty"
                       asp-action="AddDuty"
                       class="btn btn-success form-group">Yeni Ekle</a>

                </div>
            </div>
        </div>
    </div>
</div>
