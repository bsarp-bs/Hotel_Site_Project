@model WEB_UI.Models.StaffViewModel
@{
    ViewData["Title"] = "EditTeam";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Personel Kaydı</h4>

            <form class="forms-sample" method="post" asp-action="EditTeam" asp-controller="Team">

                <input type="hidden" asp-for="TeamID" />

                <div class="form-group">
                    <label asp-for="Name">İsim </label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Title">Ünvan</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Url">Link</label>
                    <input asp-for="Url" class="form-control" />
                </div>

                <button type="submit" class="btn btn-outline-primary">Kaydet</button>

            </form>

        </div>
    </div>
</div>
