@model List<StaffViewModel>

@{
    ViewData["Title"] = "TeamIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Personel Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>İsim Soyisim</th>
                                    <th>Ünvan</th>
                                    <th>URL</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                    <th>Detay</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.TeamID</td>
                                        <td>@item.Name</td>
                                        <td>@item.Title</td>
                                        <td>@item.Url</td>

                                        <td>
                                            <a asp-controller="Team"
                                               asp-action="DeleteTeam"
                                               asp-route-id="@item.TeamID"
                                               class="btn btn-success form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Team"
                                            asp-action="EditTeam"
                                            asp-route-id="@item.TeamID"
                                            class="btn btn-success form-group">Güncelle</a>
                                        </td>

                                        <td>
                                            <a href="#" class="btn btn-info btn-sm">
                                                Detay
                                            </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                    <a asp-action="AddTeam" 
                    asp-controller="Team"
                    class="btn btn-success form-group">Yeni Ekle</a>

                </div>
            </div>
        </div>
    </div>
</div>