@model WEB_UI.Models.SendedMessagesViewModel
@{
    ViewData["Title"] = "AddSendedMessages";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="col-lg-12">
    <div class="card">
        <div class="card-body">
            <div class="email-left-box">
                    <a asp-controller="Contact" asp-action="AddSendedMessages" class="btn btn-primary btn-block">Mesaj Gönder</a>
                <div class="mail-list mt-4">
                    <a asp-controller="Contact" asp-action="ContactIndex" class="list-group-item border-0 p-r-0"><i class="fa fa-inbox font-18 align-middle mr-2"></i> <b>Gelen Kutusu</b></a>
                    <a asp-controller="Contact" asp-action="SendedMessagesIndex" class="list-group-item border-0 p-r-0"><i class="fa fa-paper-plane font-18 align-middle mr-2"></i>Gönderilen</a>
                </div>
            </div>
            <div class="email-right-box">
                <div class="compose-content mt-5">
                    <form method="post" asp-controller="Contact" asp-action="AddSendedMessages">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-group">
                            <input asp-for="ReceviverMail" type="text" class="form-control bg-transparent" placeholder=" Kime">
                        </div>
                        <div class="form-group">
                            <input asp-for="Title"  type="text" class="form-control bg-transparent" placeholder=" Konu">
                        </div>
                        <div class="form-group">
                            <textarea asp-for="Message" class="textarea_editor form-control bg-light" rows="15" placeholder="Mesaj Giriniz ..."></textarea>
                        </div>
                        <div class="text-left m-t-15">
                            <button class="btn btn-primary m-b-30 m-t-15 f-s-14 p-l-20 p-r-20 m-r-10" type="submit"><i class="fa fa-paper-plane m-r-5"></i> Yolla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
