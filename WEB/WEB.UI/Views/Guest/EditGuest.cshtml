@model WEB_UI.UI_DTO.GuestDTOs.UpdateGuestDto
@{
    ViewData["Title"] = "EditGuest";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Misafir Kaydi</h4>

            <form class="forms-sample" method="post" asp-action="EditGuest" asp-controller="Guest">
                <input type="hidden" asp-for="GuestID" />

                <div class="form-group">
                    <label asp-for="Name">Misafir Adi</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Count">Kisi Sayisi</label>
                    <input asp-for="Count" class="form-control" />
                </div>

                <button type="submit" class="btn btn-outline-primary">Kaydet</button>
            </form>

        </div>
    </div>
</div>
