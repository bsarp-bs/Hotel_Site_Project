@model List<SubscribeViewModel>
@{
    ViewData["Title"] = "SubscribeIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Abone Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Mail Adresi</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.SubscribeID</td>
                                        <td>@item.Mail</td>

                                        <td>
                                            <a asp-controller="Subscribe"
                                               asp-action="DeleteSubscribe"
                                               asp-route-id="@item.SubscribeID"
                                               class="btn btn-success form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Subscribe"
                                               asp-action="EditSubscribe"
                                               asp-route-id="@item.SubscribeID"
                                               class="btn btn-success form-group">Güncelle</a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="Subscribe"
                       asp-action="AddSubscribe"
                       class="btn btn-success form-group">Yeni Ekle</a>

                </div>
            </div>
        </div>
    </div>
</div>
