@model List<WEB_UI.UI_DTO.BookingDTOs.ViewBookingDto>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="active-member">
                    <div class="table-responsive">
                        <table class="table table-xs mb-0">
                            <thead>
                                <tr>
                                    <th>İsim Soyisim</th>
                                    <th>Email</th>
                                    <th>Çocuk Sayısı</th>
                                    <th>Yetişkin Sayısı</th>
                                    <th>Oda Sayısı</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.ChildCount</td>
                                    <td>@item.AdultCount</td>
                                    <td>@item.RoomCount</td>
                                    <td>@item.Status</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>