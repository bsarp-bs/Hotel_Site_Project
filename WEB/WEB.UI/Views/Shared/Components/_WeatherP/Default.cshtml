@model WEB_UI.Models.RapidApiWeatherModel

<!DOCTYPE html>
<html class="light" lang="tr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Manrope:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "background": "#f7f9fb",
              "surface": "#f7f9fb",
              "on-surface": "#191c1e",
              "primary": "#006591",
              "on-primary": "#ffffff",
              "primary-fixed-dim": "#89ceff",
              "secondary-container": "#708cfd",
            },
            fontFamily: {
              "headline": ["Plus Jakarta Sans"],
              "body": ["Manrope"],
              "label": ["Manrope"]
            },
            borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "3xl": "1.5rem", "full": "9999px"},
          },
        },
      }
    </script>
<style>
        .glass-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .sky-gradient {
            background: linear-gradient(135deg, #006591 0%, #0ea5e9 100%);
        }
    </style>
</head>
<body class="bg-background font-body text-on-background min-h-screen flex items-center justify-center p-6">
<!-- Visual Background Enhancer -->
<div class="fixed inset-0 -z-10 bg-surface">
<div class="absolute top-[20%] left-[10%] w-[40rem] h-[40rem] bg-primary/5 rounded-full blur-[100px]"></div>
<div class="absolute bottom-[20%] right-[10%] w-[30rem] h-[30rem] bg-secondary-container/5 rounded-full blur-[100px]"></div>
</div>
<div class="w-full max-w-sm mx-auto">
<!-- Main Weather Container (Widget) -->
<div class="relative sky-gradient rounded-[2.5rem] p-8 overflow-hidden shadow-[0_20px_50px_rgba(0,101,145,0.15)] transition-all duration-300">
<!-- Top Glass Layer -->
<div class="absolute inset-0 glass-card opacity-20 pointer-events-none"></div>
<!-- Header: City & Date -->
<div class="relative z-10 flex justify-between items-start mb-10">
<div>
<h2 class="text-on-primary font-headline font-bold text-2xl tracking-tight">@Model.name</h2>
</div>
</div>
<!-- Main Data: Temp & Condition -->
<div class="relative z-10 flex flex-col items-center mb-10">
<div class="flex items-start">
<span class="text-on-primary font-headline font-extrabold text-[5.5rem] leading-none tracking-tighter">@Model.main.temp</span>
<span class="text-on-primary font-headline font-bold text-4xl mt-4">°F</span>
</div>
<div class="mt-2 px-6 py-2 bg-white/15 rounded-full backdrop-blur-lg border border-white/10">
<span class="text-on-primary font-bold text-lg tracking-wide">@Model.weather[0].description</span>
</div>
</div>
<!-- Secondary Technical Data Grid -->
<div class="relative z-10 grid grid-cols-2 gap-4">
<div class="bg-white/10 rounded-3xl p-4 flex flex-col items-center justify-center backdrop-blur-sm transition-colors hover:bg-white/20">
<span class="material-symbols-outlined text-primary-fixed-dim text-xl mb-1">water_drop</span>
<span class="text-white/60 font-label text-[10px] uppercase tracking-widest font-bold">Nem</span>
<span class="text-on-primary font-headline font-bold text-lg">% @Model.main.humidity</span>
</div>
</div>
</div>
</div>
</body></html>