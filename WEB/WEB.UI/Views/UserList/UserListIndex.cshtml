@model List<API.EntityLayer.Concrete.AppUser>
@{
    ViewData["Title"] = "UserListIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Kullanıcılar</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>İsim</th>
                                    <th>Soyisim</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Surname</td>
                                        <td>@item.UserName</td>
                                        <td>@item.Email</td>
                                    </tr>
        
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


