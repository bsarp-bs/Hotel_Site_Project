@model WEB_UI.UI_DTO.RoomDTOs.ViewRoomDto

@{
    ViewData["Title"] = "EditRoom";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Oda Kaydı</h4>

            <form class="forms-sample" method="post" asp-action="EditRoom" asp-controller="Room">

                <input type="hidden" asp-for="RoomID" />

                <div class="form-group">
                    <label asp-for="No">Oda No </label>
                    <input asp-for="No" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Title">Oda Tipi</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Price">Günlük Fiyat</label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="BedCount">Yatak Sayısı</label>
                    <input asp-for="BedCount" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Desc">Açıklama</label>
                    <input asp-for="Desc" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Image">Resim Yolu</label>
                    <input asp-for="Image" class="form-control" />
                </div>

                <button type="submit" class="btn btn-outline-primary">Kaydet</button>

            </form>

        </div>
    </div>
</div>

