@model List<ViewRoomDto>

@{
    ViewData["Title"] = "RoomIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Oda Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Oda No</th>
                                    <th>Oda Adı</th>
                                    <th>Günlük Fiyat</th>
                                    <th>Yatak Sayısı</th>
                                    <th>Açıklama</th>
                                    <th>Resim Yolu</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.RoomID</td>
                                        <td>@item.No</td>
                                        <td>@item.Title</td>
                                        <td>@item.Price</td>
                                        <td>@item.BedCount</td>
                                        <td>@item.Desc</td>
                                        <td>@item.Image</td>
                                        <td>
                                            <a asp-controller="Room"
                                               asp-action="DeleteRoom"
                                               asp-route-id="@item.RoomID"
                                               class="btn btn-success form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Room"
                                               asp-action="EditRoom"
                                               asp-route-id="@item.RoomID"
                                               class="btn btn-success form-group">Güncelle</a>
                                        </td>

                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="Room"
                       asp-action="AddRoom"
                       class="btn btn-success form-group">Yeni Ekle</a>

                </div>
            </div>
        </div>
    </div>
</div>
