@model List<ReffViewModel>
@{
    ViewData["Title"] = "ReffIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Referans Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Referans Adı</th>
                                    <th>Referans Ünvanı</th>
                                    <th>Referans Açıklama</th>
                                    <th>Referans Görsel</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                    <th>Detay</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ReffID</td>
                                        <td>@item.Name</td>
                                        <td>@item.Title</td>
                                        <td>@item.Desc</td>
                                        <td>@item.Image</td>

                                        <td>
                                            <a asp-controller="Reff"
                                               asp-action="DeleteReff"
                                               asp-route-id="@item.ReffID"
                                               class="btn btn-success form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Reff"
                                               asp-action="EditReff"
                                               asp-route-id="@item.ReffID"
                                               class="btn btn-success form-group">Güncelle</a>
                                        </td>

                                        <td>
                                            <a href="#" class="btn btn-info btn-sm">
                                                Detay
                                            </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="Reff" 
                       asp-action="AddReff"
                       class="btn btn-success form-group">Yeni Ekle</a>

                </div>
            </div>
        </div>
    </div>
</div>
