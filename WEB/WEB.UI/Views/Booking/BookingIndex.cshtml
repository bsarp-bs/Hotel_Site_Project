@model List<ViewBookingDto>

@{
    ViewData["Title"] = "BookingIndex";
    Layout = "~/Views/Admin/AdminIndex.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="card-title">
                        <h4>Rezervasyon Listesi</h4>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>İsim Soyisim</th>
                                    <th>Mail Adresi</th>
                                    <th>Durum</th>
                                    <th>Sil</th>
                                    <th>Beklemeye Al</th>
                                    <th>Onayla</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.BookingID</td>
                                        <td>@item.Name</td>
                                        <td>@item.Email</td>
                                        <td>@item.Status</td>

                                        <td>
                                            <a asp-controller="Booking"
                                               asp-action="DeleteBooking"
                                               asp-route-id="@item.BookingID"
                                               class="btn btn-outline-danger form-group">Sil</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Booking"
                                               asp-action="OnHoldBooking"
                                               asp-route-id="@item.BookingID"
                                               class="btn btn-outline-primary form-group">Beklemeye Al</a>
                                        </td>

                                        <td>
                                            <a asp-controller="Booking"
                                               asp-action="ApproveBooking"
                                               asp-route-id="@item.BookingID"
                                               class="btn btn-outline-success form-group">Onayla</a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

