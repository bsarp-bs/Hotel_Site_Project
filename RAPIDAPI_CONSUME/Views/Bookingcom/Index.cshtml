@model List<RAPIDAPI_CONSUME.Models.BookingcomModel>

@{
    ViewData["Title"] = "Booking.com Availability";
}

<div class="container py-4">
    <h1 class="mb-4">Booking.com Availability</h1>

    @if (ViewBag.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">Gosterilecek veri bulunamadi.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Time Slot Id</th>
                    <th>Start</th>
                    <th>Full Day</th>
                    <th>Offer Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TimeSlotId</td>
                        <td>@item.Start</td>
                        <td>@(item.FullDay ? "Evet" : "Hayir")</td>
                        <td>@(item.TimeSlotOffers?.Count ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
